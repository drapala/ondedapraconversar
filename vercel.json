{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "redirects": [
    {
      "source": "/:caminho((?!api/|dados/|assets/).*)",
      "has": [{ "type": "host", "value": "ondedapraconversar.vercel.app" }],
      "destination": "https://www.ondedapraconversar.com.br/:caminho",
      "permanent": true
    }
  ],
  "rewrites": [
    { "source": "/dash", "destination": "/index.html" },
    { "source": "/relatorio", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/dash",
      "headers": [{ "key": "x-robots-tag", "value": "noindex, nofollow" }]
    },
    {
      "source": "/relatorio",
      "headers": [{ "key": "x-robots-tag", "value": "noindex, nofollow" }]
    },
    {
      "source": "/dados/relatorio.json",
      "headers": [
        { "key": "cache-control", "value": "no-store" },
        { "key": "x-robots-tag", "value": "noindex, nofollow" }
      ]
    },
    {
      "source": "/dados/indice.json",
      "headers": [{ "key": "cache-control", "value": "public, max-age=300, s-maxage=86400" }]
    },
    {
      "source": "/dados/(pontos|celulas|busca|secoes|perfil2022)/(.*)",
      "headers": [{ "key": "cache-control", "value": "public, max-age=31536000, s-maxage=31536000, immutable" }]
    },
    {
      "source": "/dados/exemplo.json",
      "headers": [{ "key": "cache-control", "value": "public, max-age=31536000, s-maxage=31536000, immutable" }]
    },
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "cache-control", "value": "public, max-age=31536000, immutable" }]
    }
  ]
}
