{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [{ "source": "/dash", "destination": "/index.html" }],
  "headers": [
    {
      "source": "/dash",
      "headers": [{ "key": "x-robots-tag", "value": "noindex, nofollow" }]
    },
    {
      "source": "/dados/indice.json",
      "headers": [{ "key": "cache-control", "value": "public, max-age=300, s-maxage=86400" }]
    },
    {
      "source": "/dados/(pontos|celulas|busca|secoes|perfil2022)/(.*)",
      "headers": [{ "key": "cache-control", "value": "public, max-age=31536000, s-maxage=31536000, immutable" }]
    },
    {
      "source": "/dados/exemplo.json",
      "headers": [{ "key": "cache-control", "value": "public, max-age=31536000, s-maxage=31536000, immutable" }]
    },
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "cache-control", "value": "public, max-age=31536000, immutable" }]
    }
  ]
}
